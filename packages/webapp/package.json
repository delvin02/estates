  "dependencies": {
    "@inlang/paraglide-js": "^2.0.0",
    "@lucide/svelte": "^0.487.0",
    "add": "^2.0.6",
    "bits-ui": "^1.3.19",
    "bullmq": "^5.49.1",
    "chart.js": "^4.4.9",
    "class-variance-authority": "^0.7.1",
